# Copy this file to .env and fill in real values. .env is gitignored.

# --- Tools ---
# check_weather needs no key (public data.gov.sg API).
GOOGLE_MAPS_API_KEY=
TAVILY_API_KEY=

# --- Model / tracing ---
OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=date-planner

# --- Persistence (only needed for `docker-compose up` prod-like testing) ---
# `langgraph dev` needs neither of these — it runs fully in-memory.
# In real LangGraph Cloud deployments, these are injected by the platform
# and point at managed Redis/Postgres instead of the local containers below.
REDIS_URI=redis://langgraph-redis:6379
POSTGRES_URI=postgres://postgres:postgres@langgraph-postgres:5432/postgres?sslmode=disable

# --- App data (Supabase Postgres: user_profiles, date_ideas) ---
# Local: run `supabase start` in the repo root, then `supabase status` to confirm this URL.
# Hosted: Supabase dashboard -> Project Settings -> Database -> Connection string.
SUPABASE_DB_URI=postgresql://postgres:postgres@127.0.0.1:54322/postgres
